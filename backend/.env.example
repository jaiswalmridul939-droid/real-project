# Local SQLite is the default. For Docker Compose use the PostgreSQL URL in the root .env.example.
DATABASE_URL=sqlite:///./claim_whats_yours.db
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CLAUDE_API_KEY=
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=demo-admin-change-me
ENABLE_SCHEDULER=true
